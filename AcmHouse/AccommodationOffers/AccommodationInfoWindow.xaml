<Window x:Class="AcmHouse.AccommodationOffers.AccommodationInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="720" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="160 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Предложения" Click="OffersButton_Click" Width="132" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилые" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческие" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="TradeButton" Style="{StaticResource topButtonsPanel}" Content="Торговля" Click="TradeButton_Click" Width="84" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TradeContextMenu">
                            <MenuItem Header="Купить недвижимость">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Купить недвижимость"/>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>
                                <MenuItem Header="Жилую" Click="BuyResidentialProperty_Click"/>
                                <MenuItem Header="Коммерческую" Click="BuyCommercialProperty_Click"/>
                            </MenuItem>
                            <MenuItem Header="Продать">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Продать недвижимость"/>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>
                                <MenuItem Header="Жилую" Click="SellResidentialProperty_Click"/>
                                <MenuItem Header="Коммерческую" Click="SellCommercialProperty_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Календарь мероприятий" Click="EventsButton_Click" Width="211" Foreground="Black"/>
                <Button x:Name="ProfileButton" Style="{StaticResource topButtonsPanel}" Content="Профиль" Click="ProfileButton_Click" Width="82" Foreground="Black"/>
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>

        <!--Middle Section-->

        <Grid Grid.Row="1" RenderTransformOrigin="0.488,0.5">
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>

            <WrapPanel x:Name="accommodationInfo" Width="563" Height="571" HorizontalAlignment="Left" Margin="20,10,0,10"/>
            <Border Height="215" VerticalAlignment="Top" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="700,81,88,0">
                <StackPanel Margin="-22,-18,-22,-22">
                    <DataGrid d:ItemsSource="{d:SampleData ItemCount=3}" x:Name="rentalSchedule" Height="187" IsReadOnly="True"/>
                </StackPanel>
            </Border>
            <TextBlock Foreground="Black" FontFamily="Verdana"  FontSize="21" Margin="743,50,0,515" Text="Записи аренд" HorizontalAlignment="Left" Width="148" RenderTransformOrigin="0.45,2.486"/>
            <Button x:Name="SendObjectButton" Content="Отправка объекта клиенту" Style="{StaticResource mainButton}" Margin="694,316,82,235" BorderBrush="Black" Background="White" Foreground="Black" Click="SendObjectButton_Click"/>
            <Label x:Name="ClientEmailLabel" HorizontalAlignment="Left" Foreground="Black" Content="Укажите почту клиента ниже" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="719,323,0,0" Width="198" Visibility="Collapsed"/>
            <TextBox x:Name="ClientEmailTextBox" MaxLength="33" Margin="705,347,0,0" Padding="0" Foreground="Black" 
            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" VerticalAlignment="Top" BorderBrush="Black" Visibility="Collapsed"/>
            <Button x:Name="SendEmailButton" Content="Отправить" Style="{StaticResource mainButton}" Margin="705,377,211,174" BorderBrush="Black" Background="Green" Foreground="White" Click="SendEmailButton_Click" Visibility="Collapsed" RenderTransformOrigin="0.71,0.478"/>
            <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource mainButton}" Margin="823,377,93,174" BorderBrush="Black" Background="Red" Foreground="White" Click="CancelButton_Click" Visibility="Collapsed" RenderTransformOrigin="0.71,0.478"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>
        </Grid>
        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 2 0 0" BorderBrush="Black" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>