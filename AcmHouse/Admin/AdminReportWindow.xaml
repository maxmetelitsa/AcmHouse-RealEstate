<Window x:Class="AcmHouse.Admin.AdminReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="807" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="130 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Учет предложений" Click="OffersButton_Click" Width="163" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилой" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческой" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AccommodationsButton" Style="{StaticResource topButtonsPanel}" Content="Договоры" Click="RentalTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EmployeesButton" Style="{StaticResource topButtonsPanel}" Content="Сотрудники" Click="EmployeesTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Мероприятия" Width="120" Foreground="Black"/>
                <Button x:Name="ReportButton" Style="{StaticResource topButtonsPanel}" Content="Отчет" Click="ReportButton_Click" Width="58" Foreground="Black"/>
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>


        <!--Middle Section-->

        <Grid Grid.Row="1" Height="675" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <Label Content="Статистика компании" Foreground="Black" HorizontalAlignment="Center" FontSize="30" FontFamily="Verdana" Margin="0,10,0,610" Grid.ColumnSpan="1"/>
            <StackPanel Margin="0,60,0,489" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="414">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0.31"/>
                        <RotateTransform/>
                        <TranslateTransform X="0.745"/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83*"/>
                        <ColumnDefinition Width="79*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="StartDateLabel" HorizontalAlignment="Left" Foreground="Black" Content="Начало" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,23,40,0" Width="120"/>
                    <xctk:DateTimePicker x:Name="StartDatePicker" Margin="1,25,0,0" Padding="0" Foreground="Black" 
                Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top" ValueChanged="StartDatePicker_SelectedDateChanged"/>
                </Grid>
                <Label x:Name="StartDateNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Height="27" Margin="0 0 92 0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83*"/>
                        <ColumnDefinition Width="79*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="EndDateLabel" HorizontalAlignment="Left" Foreground="Black" Content="Окончание" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,-2,40,0" Width="120"/>
                    <xctk:DateTimePicker x:Name="EndDatePicker" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top" ValueChanged="EndDatePicker_SelectedDateChanged"/>
                </Grid>
                <Label x:Name="EndDateNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Margin="0 0 92 0" Height="27"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83*"/>
                        <ColumnDefinition Width="83*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="83*"/>
                    <ColumnDefinition Width="79*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="CompanyProfitLabel" Foreground="Black" Content="Итовая прибыль компании" FontFamily="Verdana" Height="24" Margin="172,134,145,509" Grid.Column="1"/>
                <TextBox x:Name="CompanyProfitTextBox" Margin="354,136,0,0" Padding="0" Foreground="Black" BorderBrush="Black"
            Panel.ZIndex="1" HorizontalAlignment="Left" Width="135" Height="24" FontSize="14" VerticalAlignment="Top" Grid.Column="1"/>
            </Grid>
            <DataGrid x:Name="ReportDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10,170,10,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="*"/>
                    <DataGridTextColumn Header="Номер договора" Binding="{Binding OrderID}" Width="*"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="Итоговая сумма" Binding="{Binding TotalPrice}" Width="*"/>
                    <DataGridTextColumn Header="Прибыль сотрудника" Binding="{Binding EmployeeProfit}" Width="*"/>
                    <DataGridTextColumn Header="Прибыль компании" Binding="{Binding CompanyProfit}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 5 0 0" BorderBrush="White" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>