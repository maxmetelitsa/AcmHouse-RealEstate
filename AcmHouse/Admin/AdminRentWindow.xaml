<Window x:Class="AcmHouse.Admin.AdminRentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="720" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 0" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="130 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Учет предложений" Click="OffersButton_Click" Width="163" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилой" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческой" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AccommodationsButton" Style="{StaticResource topButtonsPanel}" Content="Договоры" Click="RentalTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EmployeesButton" Style="{StaticResource topButtonsPanel}" Content="Сотрудники" Click="EmployeesTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Мероприятия" Click="EventsTrackingButton_Click" Width="120" Foreground="Black"/>
                <Button x:Name="ReportButton" Style="{StaticResource topButtonsPanel}" Content="Отчет" Click="ReportButton_Click" Width="58" Foreground="Black"/>

            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>


        <!--Middle Section-->
        <Grid Grid.Row="1" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="399*"/>
                <ColumnDefinition Width="625*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <StackPanel Grid.ColumnSpan="2">
                <Border Width="254" HorizontalAlignment="Left" Height="572">
                    <Grid Margin="40,90">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Content="Тип" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" Margin="-5,0,0,0" FontSize="18"/>

                        <ComboBox x:Name="TypeComboBox" Margin="0,5,6,54" Grid.Row="1" SelectionChanged="TypeComboBox_SelectionChanged" Foreground="Black" Grid.RowSpan="2"/>

                        <Label Content="Сортировка по цене" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Black" Margin="-3,45,0,0" Grid.Row="2" FontSize="18" Width="180"/>

                        <ComboBox x:Name="PriceComboBox" Margin="0,5,6,0" Grid.Row="3" SelectionChanged="PriceComboBox_SelectionChanged" Foreground="Black"/>

                        <Label x:Name="AreaNameLabel" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Black" Margin="-2,20,0,0" Grid.Row="4" FontSize="18" Width="180">
                            <TextBlock>
                            <Run x:Name="LabelLine1" Text="Количество"/>
                            <LineBreak/>
                            <Run x:Name="LabelLine2" Text="комнат"/>            
                            </TextBlock>
                        </Label>
                        <TextBox x:Name="RoomsAmountTextBox" MaxLength="2" Padding="0" Foreground="Black" HorizontalAlignment="Left" Width="174" Height="24" FontSize="14" Grid.Row="5" Margin="0,5,0,0" VerticalAlignment="Top" BorderBrush="Black" TextChanged="RoomsAmountTextBox_TextChanged"/>
                        <Label Content="Площадь" VerticalAlignment="Top" Foreground="Black" Margin="-3,20,0,0" Grid.Row="6" FontSize="18" Width="180"/>
                        <TextBox x:Name="AreaTextBox" MaxLength="4" Padding="0" Foreground="Black" HorizontalAlignment="Left" Width="174" Height="24" FontSize="14" Grid.Row="7" Margin="0,5,0,0" VerticalAlignment="Top" BorderBrush="Black" TextChanged="AreaAmountTextBox_TextChanged"/>
                        <Button x:Name="ClearFilterButton" Content="Очистить фильтр" Width="130" Margin="22,20,26,0" Click="ClearFilterButton_Click" Grid.Row="8" FontSize="16" Background="White" Foreground="#212121" RenderTransformOrigin="0.508,2.882"/>
                    </Grid>
                </Border>
            </StackPanel>
            <ScrollViewer Margin="261,82,0,0" Grid.ColumnSpan="2">
                <WrapPanel x:Name="accommodationsGrid" HorizontalAlignment="Center" Margin="5">

                </WrapPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0 2 0 0" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
