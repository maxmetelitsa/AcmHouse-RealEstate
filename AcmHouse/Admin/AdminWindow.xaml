<Window x:Class="AcmHouse.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="807" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="130 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Учет предложений" Click="OffersButton_Click" Width="163" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилой" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческой" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AccommodationsButton" Style="{StaticResource topButtonsPanel}" Content="Договоры" Click="RentalTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EmployeesButton" Style="{StaticResource topButtonsPanel}" Content="Сотрудники" Click="EmployeesTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Мероприятия" Click="EventsTrackingButton_Click" Width="120" Foreground="Black"/>
                <Button x:Name="ReportButton" Style="{StaticResource topButtonsPanel}" Content="Отчет" Click="ReportButton_Click" Width="58" Foreground="Black"/>
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>


        <!--Middle Section-->

        <Grid Grid.Row="1" Height="667" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <Label Content="Учет предложений жилой недвижимости" Foreground="Black" HorizontalAlignment="Center" FontSize="30" FontFamily="Verdana" Margin="0,0,0,546" Grid.ColumnSpan="2"/>
            <Border Width="416" Height="591" VerticalAlignment="Top" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="0,66,0,0">
                <StackPanel Margin="-22,-18,-22,-22">
                    <TextBlock Foreground="White" FontFamily="Verdana"  FontSize="18" Margin="0 0 0 10" Text="Добавление жилой недвижимости" HorizontalAlignment="Center"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="NameLabel" HorizontalAlignment="Left" Foreground="White" Content="Название" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="19,24,0,0" Width="120"/>
                        <TextBox x:Name="NameTextBox" MaxLength="33" Margin="87,25,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top" />
                    </Grid>
                    <Label x:Name="NameNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Height="27" Margin="0 0 80 0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TypeLabel" HorizontalAlignment="Center" Foreground="White" Content="Тип" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="0,-2,40,0" Width="120"/>
                        <ComboBox x:Name="TypeComboBox" Margin="87,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Center" SelectionChanged="TypeComboBox_SelectionChanged"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="TypeNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 80 0" Height="27"/>
                    <!--Email TextBox-->
                    <Grid>
                        <Label x:Name="RoomsLabel" HorizontalAlignment="Left" Foreground="White" Content="Комнаты" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="21,-2,0,0" Width="120"/>
                        <TextBox x:Name="RoomsTextBox" Margin="2,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="RoomsNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 80 0" Height="27"/>
                    <Grid>
                        <Label x:Name="AreaLabel" HorizontalAlignment="Left" Foreground="White" Content="Площадь" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="21,-2,0,0" Width="120"/>
                        <TextBox x:Name="AreaTextBox" Margin="2,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="AreaNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 80 0" Height="27"/>
                    <!--Password TextBox-->
                    <Grid>
                        <Label x:Name="AdressLabel" HorizontalAlignment="Left" Foreground="White" Content="Адрес" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="21,-2,0,0" Width="120"/>
                        <TextBox x:Name="AdressTextBox" Margin="2,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="AddressNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 80 0" Height="27"/>
                    <!--Password TextBox-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="FlatNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="Квартира" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="19,0,0,0" Width="120"/>

                        <TextBox x:Name="FlatNumberTextBox" MaxLength="33" Margin="2,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                    </Grid>
                    <Label x:Name="FlatNumberNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 80 0" Height="27"/>
                    <Grid Height="55">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                        </Grid.ColumnDefinitions>

                        <Label x:Name="ImageIDLabel" HorizontalAlignment="Left" Foreground="White" Content="Номер&#x0a;фото" FontFamily="Verdana" VerticalAlignment="Top" Height="41" Margin="20,-8,0,0" Width="53"/>

                        <TextBox x:Name="ImageIDTextBox" Margin="2,0,84,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" VerticalAlignment="Top" BorderBrush="#212121" Grid.Column="1"/>
                        <Label x:Name="ImageNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0,27,85,0"/>


                        <Button x:Name="BrowseButton" Content="Выбрать" Background="White" BorderBrush="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Width="75" Click="BrowseButton_Click"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="HourPriceLabel" HorizontalAlignment="Left" Foreground="White" Content="Стоимость за день" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="19,0,0,0" Width="129"/>

                        <TextBox x:Name="HourPriceTextBox" MaxLength="33" Margin="155,0,85,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" Height="24" FontSize="14" Grid.ColumnSpan="2"/>
                    </Grid>
                    <Label x:Name="HourPriceNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0,0,85,-5"/>


                    <Grid Margin="0 5 0 0" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AcAddButton" Content="Добавить" Style="{StaticResource mainButton}" Margin="0,0,15,0" BorderBrush="White" Background="White" Foreground="Black" Click="ACAddButton_Click"/>
                        <Button x:Name="AcDeleteDButton" Content="Удалить" Style="{StaticResource mainButton}" Margin="10,0,5,0" BorderBrush="White" Background="White" Foreground="Black" Click="ACDeleteButton_Click" Grid.Column="1"/>
                        <Button x:Name="AcClearFieldsButton" Content="Очистить поля" Style="{StaticResource mainButton}" Margin="10,0,5,0" BorderBrush="White" Background="White" Foreground="Black" Click="ACClearFieldsButton_Click" Grid.Column="2"/>
                    </Grid>

                </StackPanel>
            </Border>

            <Border Width="468" Height="593" VerticalAlignment="Top" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="0,64,0,0" Grid.Column="1">
                <StackPanel Margin="-22,-18,-22,-22">
                    <DataGrid d:ItemsSource="{d:SampleData ItemCount=3}" x:Name="acGrid" Height="508" IsReadOnly="True"/>
                    <Grid Margin="0 ">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AcEditButton" Width = "117" Content="Изменить" Style="{StaticResource mainButton}" Margin="10,10,10,0" BorderBrush="White" Background="White" Foreground="Black" Click="ACEditButton_Click" Grid.Column="0" RenderTransformOrigin="0.483,1.115"/>
                        <Button x:Name="AcSaveChangesButton" Content="Сохранить изменения" Style="{StaticResource mainButton}" Margin="3,10,3,0" BorderBrush="White" Background="White" Foreground="Black" Click="ACSaveChangesButton_Click" Grid.Column="1"/>
                        <Button x:Name="AcClearTableButton" Width ="117" Content="Очистить таблицу" Style="{StaticResource mainButton}" Margin="10,10,5,0" BorderBrush="White" Background="White" Foreground="Black" Click="ACClearTableButton_Click" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 5 0 0" BorderBrush="White" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>