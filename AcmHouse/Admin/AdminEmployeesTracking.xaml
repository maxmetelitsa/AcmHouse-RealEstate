<Window x:Class="AcmHouse.Admin.AdminEmployeesTracking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="807" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 0" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="130 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Учет предложений" Click="OffersButton_Click" Width="163" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилой" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческой" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AccommodationsButton" Style="{StaticResource topButtonsPanel}" Content="Договоры" Click="RentalTrackingButton_Click" Width="100" Foreground="Black"/>
                <Button x:Name="EmployeesButton" Style="{StaticResource topButtonsPanel}" Content="Сотрудники" Width="100" Foreground="Black"/>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Мероприятия" Click="EventsTrackingButton_Click" Width="120" Foreground="Black"/>
                <Button x:Name="ReportButton" Style="{StaticResource topButtonsPanel}" Content="Отчет" Click="ReportButton_Click" Width="58" Foreground="Black"/>
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>


        <!--Middle Section-->

        <Grid Grid.Row="1" Height="677" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <Label Content="Отслеживание сотрудников" Foreground="Black" HorizontalAlignment="Center" FontSize="30" FontFamily="Verdana" Margin="0,5,0,546" Grid.ColumnSpan="3"/>
            <Border Width="590" Height="600" VerticalAlignment="Top" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="0,60,0,0" Grid.Column="0" Grid.ColumnSpan="2">
                <StackPanel Margin="-22,-20,-22,-22">
                    <DataGrid d:ItemsSource="{d:SampleData ItemCount=3}" x:Name="employeesGrid" Height="520" IsReadOnly="True"/>
                    <Grid Margin="0 ">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LookButton" Width = "140" Content="Просмотреть" Style="{StaticResource mainButton}" Margin="10,10,10,0" BorderBrush="White" Background="White" Foreground="Black" Click="LookButton_Click" Grid.Column="0" RenderTransformOrigin="0.483,1.115"/>
                        <Button x:Name="AddButton" Width = "140" Content="Добавить сотрудника" Style="{StaticResource mainButton}" Margin="10,10,10,0" BorderBrush="White" Background="White" Foreground="Black" Click="EmployeeAddButton_Click" Grid.Column="1" RenderTransformOrigin="0.483,1.115"/>
                        <Button x:Name="DeleteButton" Width = "140" Content="Удалить сотрудника" Style="{StaticResource mainButton}" Margin="10,10,10,0" BorderBrush="White" Background="White" Foreground="Black" Click="EmployeeDeleteButton_Click" Grid.Column="2" RenderTransformOrigin="0.483,1.115"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 2 0 0" BorderBrush="Black" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse Co. 2024" Foreground="Black" FontFamily="Verdana" FontSize="18" Margin="10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black" FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>