<Window x:Class="AcmHouse.Admin.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="768" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="160 0 20 0">
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>


        <!--Middle Section-->

        <Grid Grid.Row="1" Margin="-4,0,4,0">
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <Border Width="397" Height="350" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="Gray" Margin="10,46,0,0">
                <StackPanel Margin="0,-18,-22,-22">
                    <TextBlock Foreground="White" FontFamily="Verdana"  FontSize="20" Margin="0 0 0 10" Text="Данные сотрудника" HorizontalAlignment="Center"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="NameLabel" HorizontalAlignment="Left" Foreground="White" Content="Имя" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="-22,24,0,0" Width="120"/>
                        <TextBox x:Name="NameTextBox" MaxLength="33" Margin="88,25,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top" IsReadOnly="True"/>
                    </Grid>
                    <Label x:Name="NameNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Height="27" Margin="0 0 92 0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SurnameLabel" HorizontalAlignment="Left" Foreground="White" Content="Фамилия" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Width="120" Margin="-22,0,0,0"/>
                        <TextBox x:Name="SurnameTextBox" Margin="88,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" IsReadOnly="True"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="SurnameNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Margin="0 0 92 0" Height="27"/>
                    <!--Email TextBox-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="EmailLabel" HorizontalAlignment="Left" Foreground="White" Content="Email" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Width="120" Margin="-22,0,0,0"/>
                        <TextBox x:Name="EmailTextBox" Margin="88,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" IsReadOnly="True"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="EmailNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Margin="0 0 92 0" Height="27"/>
                    <Grid>
                        <Label x:Name="PassportNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="Номер паспорта" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="-22,-2,0,0" Width="120"/>
                        <TextBox x:Name="PassportNumberTextBox" Margin="88,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" IsReadOnly="True"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="PassportNumberNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Margin="0 0 92 0" Height="27"/>
                    <Grid>
                        <Label x:Name="IdentificationNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="ID номер" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="-22,-2,0,0" Width="120"/>
                        <TextBox x:Name="IdentificationNumberTextBox" Margin="88,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" IsReadOnly="True"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="IdentificationNumberNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Margin="0 0 92 0" Height="27"/>
                    <!--Password TextBox-->
                </StackPanel>
            </Border>
            <ListBox x:Name="RentalsListBox" SelectionChanged="ListBox_SelectionChanged" Margin="488,394,56,35" MouseDoubleClick="RentalsListBox_MouseDoubleClick" IsSynchronizedWithCurrentItem="True" BorderBrush="Black" BorderThickness="2">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel x:Name="BookingStackPanel">
                            <TextBlock x:Name="BookingTextBlock" Foreground="Black" FontSize="16" Text="{Binding BookingText}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Height="215" VerticalAlignment="Top" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="454,84,335,0">
                <StackPanel Margin="-22,-18,-22,-22">
                    <DataGrid d:ItemsSource="{d:SampleData ItemCount=3}" x:Name="openedShiftsGrid" Height="187" IsReadOnly="True"/>
                </StackPanel>
            </Border>
            <Border Height="215" VerticalAlignment="Top" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="754,84,34,0">
                <StackPanel Margin="-22,-18,-22,-22">
                    <DataGrid d:ItemsSource="{d:SampleData ItemCount=3}" x:Name="closedShiftsGrid" Height="190" IsReadOnly="True"/>
                </StackPanel>
            </Border>
            <TextBlock Foreground="Black" FontFamily="Verdana"  FontSize="20" Margin="642,26,0,585" Text="График работы" HorizontalAlignment="Left" Width="161" RenderTransformOrigin="0.45,2.486"/>
            <TextBlock Foreground="Black" FontFamily="Verdana"  FontSize="20" Margin="490,311,0,300" Text="Открытие смены" HorizontalAlignment="Left" Width="175" RenderTransformOrigin="0.45,2.486"/>
            <TextBlock Foreground="Black" FontFamily="Verdana"  FontSize="20" Margin="793,311,0,300" Text="Закрытие смены" HorizontalAlignment="Left" Width="175" RenderTransformOrigin="0.45,2.486"/>
            <TextBlock Foreground="Black" FontFamily="Verdana"  FontSize="20" Margin="604,358,0,252" Text="Заключенные договоры" HorizontalAlignment="Left" Width="248" RenderTransformOrigin="0.45,2.486"/>
            <TextBlock Foreground="Black" FontFamily="Verdana"  FontSize="15" Margin="276,531,0,66" HorizontalAlignment="Left" Width="193"><Run Text="Сумма отчислений с"/><LineBreak/><Run Text="заключенных договоров"/></TextBlock>
            <TextBox x:Name="DeductionsTextBox" Margin="276,578,0,0" Padding="0" Foreground="Black" 
            Panel.ZIndex="1" HorizontalAlignment="Left" Width="192" Height="24" FontSize="15" VerticalAlignment="Top" IsReadOnly="True" BorderBrush="Black" BorderThickness="2"/>
        </Grid>

        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 2 0 0" BorderBrush="Black" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>