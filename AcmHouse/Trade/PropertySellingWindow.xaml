<Window x:Class="AcmHouse.Trade.PropertySellingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d" Height="807" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="160 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Предложения" Click="OffersButton_Click" Width="132" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилые" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческие" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="TradeButton" Style="{StaticResource topButtonsPanel}" Content="Торговля" Click="TradeButton_Click" Width="84" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TradeContextMenu">
                            <MenuItem Header="Купить недвижимость">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Купить недвижимость"/>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>
                                <MenuItem Header="Жилую" Click="BuyResidentialProperty_Click"/>
                                <MenuItem Header="Коммерческую" Click="BuyCommercialProperty_Click"/>
                            </MenuItem>
                            <MenuItem Header="Продать">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Продать недвижимость"/>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>
                                <MenuItem Header="Жилую" Click="SellResidentialProperty_Click"/>
                                <MenuItem Header="Коммерческую" Click="SellCommercialProperty_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Календарь мероприятий" Click="EventsButton_Click" Width="211" Foreground="Black"/>
                <Button x:Name="ProfileButton" Style="{StaticResource topButtonsPanel}" Content="Профиль" Click="ProfileButton_Click" Width="82" Foreground="Black"/>
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>


        <!--Middle Section-->

        <Grid Grid.Row="1" Height="667" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <Label x:Name="MainLabel" Content="Продажа жилой недвижимости" Foreground="Black" HorizontalAlignment="Center" FontSize="30" FontFamily="Verdana" Margin="0,0,0,546" Grid.ColumnSpan="2"/>
            <Border Width="884" Height="591" VerticalAlignment="Top" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="0,66,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410" />
                        <ColumnDefinition Width="410" />
                    </Grid.ColumnDefinitions>

                    <!-- Left StackPanel -->
                    <StackPanel Grid.Column="0" Margin="10" HorizontalAlignment="Left" Width="340">
                        <TextBlock Foreground="White" FontFamily="Verdana" FontSize="18" Margin="0 0 0 10" Text="Информация о недвижимости" HorizontalAlignment="Center" Width="279"/>

                        <!-- Name Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="NameLabel" HorizontalAlignment="Left" Foreground="White" Content="Название" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,24,0,0" Width="120"/>
                            <TextBox x:Name="NameTextBox" MaxLength="33" Margin="0,25,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top" />
                        </Grid>
                        <Label x:Name="NameNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Height="27" Margin="0 0 0 0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="TypeLabel" HorizontalAlignment="Left" Foreground="White" Content="Тип" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Width="32" Margin="0,0,0,0"/>
                            <ComboBox x:Name="TypeComboBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Center" SelectionChanged="TypeComboBox_SelectionChanged"/>
                            <!--<ICon:PackIconMAterial/>-->
                        </Grid>
                        <Label x:Name="TypeNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <!--Email TextBox-->
                        <Grid>
                            <Label x:Name="RoomsLabel" HorizontalAlignment="Left" Foreground="White" Content="Комнаты" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,-2,0,0" Width="120"/>
                            <TextBox x:Name="RoomsTextBox" Margin="2,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14"/>
                            <!--<ICon:PackIconMAterial/>-->
                        </Grid>
                        <Label x:Name="RoomsNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <Grid>
                            <Label x:Name="AreaLabel" HorizontalAlignment="Left" Foreground="White" Content="Площадь" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,-2,0,0" Width="120"/>
                            <TextBox x:Name="AreaTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14"/>
                            <!--<ICon:PackIconMAterial/>-->
                        </Grid>
                        <Label x:Name="AreaNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <!--Password TextBox-->
                        <Grid>
                            <Label x:Name="AdressLabel" HorizontalAlignment="Left" Foreground="White" Content="Адрес" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,-2,0,0" Width="120"/>
                            <TextBox x:Name="AdressTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14"/>
                            <!--<ICon:PackIconMAterial/>-->
                        </Grid>
                        <Label x:Name="AddressNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <!--Password TextBox-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="FlatNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="Квартира" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="0,0,0,0" Width="120"/>

                            <TextBox x:Name="FlatNumberTextBox" MaxLength="33" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="FlatNumberNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                            </Grid.ColumnDefinitions>

                            <Label x:Name="ImageIDLabel" HorizontalAlignment="Left" Foreground="White" Content="Номер фото" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,-2,0,0" Width="90"/>

                            <TextBox x:Name="ImageIDTextBox" Margin="0,0,84,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Right" Width="142" Height="24" FontSize="14" VerticalAlignment="Top" BorderBrush="#212121"/>

                            <Button x:Name="BrowseButton" Content="Выбрать" Background="White" BorderBrush="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Width="75" Click="BrowseButton_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="83*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="ImageNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0,0,0,-5" Grid.ColumnSpan="2"/>
                        </Grid>
                        <Grid>
                            <Label x:Name="HourPriceLabel" HorizontalAlignment="Left" Foreground="White" Content="Стоимость" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="0,0,0,0" Width="129"/>
                            <TextBox x:Name="HourPriceTextBox" MaxLength="33" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Height="24" Width="226" FontSize="14" BorderBrush="Black"/>
                        </Grid>
                        <Label x:Name="HourPriceNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0,0,0,0" Grid.ColumnSpan="2"/>
                        <!-- Buttons Section -->
                        <Grid Margin="0,5,0,0" Height="57">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AcAddButton" Content="Выставить на продажу" Style="{StaticResource mainButton}" Margin="0,-20,15,9" BorderBrush="White" Background="White" Foreground="Black" Click="PutForSaleButton_Click"/>
                            <Button x:Name="AcClearFieldsButton" Content="Очистить поля" Style="{StaticResource mainButton}" Margin="10,-6,5,23" BorderBrush="White" Background="White" Foreground="Black" Click="ACClearFieldsButton_Click" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>

                    <!-- Right StackPanel -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" Width="340" Margin="10,10,0,-5">
                        <TextBlock Foreground="White" FontFamily="Verdana" FontSize="18" Margin="0 0 0 0" Text="Данные продавца" HorizontalAlignment="Center" Width="168"/>

                        <!-- Clients Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="ClientsLabel" HorizontalAlignment="Left" Foreground="White" Content="Клиенты" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,29,0,0" Width="64"/>
                            <ComboBox x:Name="ClientComboBox" HorizontalAlignment="Right" IsEditable="True" Width="226" Height="24"  Loaded="ClientComboBox_Loaded" SelectionChanged="ClientComboBox_SelectionChanged" Margin="2 30 0 0" Grid.ColumnSpan="2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Surname}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="SurnameLabel" HorizontalAlignment="Left" Foreground="White" Content="Фамилия" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,24,0,0" Width="75"/>
                            <TextBox x:Name="SurnameTextBox" MaxLength="33" Margin="0,25,0,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="NameNotify2" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Height="27" Margin="0 0 0 0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="InitialsLabel" HorizontalAlignment="Left" Foreground="White" Content="Инициалы" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="0,-2,40,0" Width="120"/>
                            <TextBox x:Name="InitialsTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
        Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="SurnameNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="EmailLabel" HorizontalAlignment="Left" Foreground="White" Content="Почта" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="0,-2,40,0" Width="120"/>
                            <TextBox x:Name="EmailTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="EmailNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="PhoneLabel" HorizontalAlignment="Left" Foreground="White" Content="Телефон" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="0,-2,40,0" Width="120"/>
                            <TextBox x:Name="PhoneTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="PhoneNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <Grid>
                            <Label x:Name="PassportNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="Номер паспорта" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,0,0,0" Width="120"/>
                            <TextBox x:Name="PassportNumberTextBox" MaxLength="9" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14"/>
                        </Grid>
                        <Label x:Name="PassportNumberNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 0" Height="27"/>
                        <Grid Height="39">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="IdentificationLabel" HorizontalAlignment="Left" Foreground="White" Content="Идентифи-&#x0a;кационный&#x0a;номер" FontFamily="Verdana" VerticalAlignment="Top" Height="60" Margin="0,-10,0,0" Width="143"/>
                            <TextBox x:Name="IdentificationTextBox" MaxLength="14" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="IdentificationNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Margin="0 0 0 20" Height="27"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="StartDateLabel" HorizontalAlignment="Left" Foreground="White" Content="Дата начала" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="0,-19,0,0" Width="120"/>
                            <xctk:DateTimePicker x:Name="StartDatePicker" Margin="0,-19,-1,0" Padding="0" Foreground="Black" 
                       Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="StartDateNotify" HorizontalAlignment="Right" Content="" FontSize="13" Foreground="White" Height="27" Margin="0 0 0 0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="83*"/>
                                <ColumnDefinition Width="79*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="EndDateLabel" HorizontalAlignment="Left" Foreground="White" Content="Дата окончания" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Width="109"/>
                            <xctk:DateTimePicker x:Name="EndDatePicker" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Right" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        </Grid>
                        <Label x:Name="EndDateNotify" HorizontalAlignment="Right" Content="" FontSize="14" Foreground="White" Margin="0 0 0 0" Height="27"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 5 0 0" BorderBrush="White" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>