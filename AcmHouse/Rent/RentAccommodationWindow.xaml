<Window x:Class="AcmHouse.Rent.RentAccommodationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"

        mc:Ignorable="d" Height="720" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10" MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>
        <Grid>
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="160 0 20 0">
                <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Предложения" Click="OffersButton_Click" Width="132" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OffersContextMenu">
                            <MenuItem Header="Жилые" Click="ResidentialOffers_Click"/>
                            <MenuItem Header="Коммерческие" Click="CommercialOffers_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RentContextMenu">
                            <MenuItem Header="Жилая" Click="Residential_Click"/>
                            <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="TradeButton" Style="{StaticResource topButtonsPanel}" Content="Торговля" Click="TradeButton_Click" Width="84" Foreground="Black">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="TradeContextMenu">
                            <MenuItem Header="Купить недвижимость">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Купить недвижимость"/>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>
                                <MenuItem Header="Жилую" Click="BuyResidentialProperty_Click"/>
                                <MenuItem Header="Коммерческую" Click="BuyCommercialProperty_Click"/>
                            </MenuItem>
                            <MenuItem Header="Продать">
                                <MenuItem.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Продать недвижимость"/>
                                    </DataTemplate>
                                </MenuItem.HeaderTemplate>
                                <MenuItem Header="Жилую" Click="SellResidentialProperty_Click"/>
                                <MenuItem Header="Коммерческую" Click="SellCommercialProperty_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Календарь мероприятий" Click="EventsButton_Click" Width="211" Foreground="Black"/>
                <Button x:Name="ProfileButton" Style="{StaticResource topButtonsPanel}" Content="Профиль" Click="ProfileButton_Click" Width="82" Foreground="Black"/>
            </StackPanel>

            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22" Margin="10"/>
        </Grid>

        <!--Middle Section-->

        <Grid Grid.Row="1" RenderTransformOrigin="0.488,0.5">
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>

            <Border Width="512" Height="355" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"
                    BorderBrush="Black" BorderThickness="2" Background="#FF565656" DataContext="{Binding Card}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="351" Width="250" Margin="20,0,0,0" HorizontalAlignment="Left" Source="{Binding ImagePath}"/>
                    <StackPanel Width="200" Margin="30,80,10,10">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock><Run Text="Название: "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Тип: "/><Run Text="{Binding TypeName, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Количество комнат: "/><Run Text="{Binding Rooms, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Площадь: "/><Run Text="{Binding Area, Mode=OneWay}"/><Run Text=" м"/><Run Text="2" BaselineAlignment="Superscript" FontSize="7"/></TextBlock>
                        <TextBlock><Run Text="Адрес: "/><Run Text="{Binding Address, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Стоимость за сутки: "/><Run Text="{Binding DayPrice, Mode=OneWay}"/><Run Text=" руб."/></TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Width="497" Height="571" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="4,14,0,0">
                <StackPanel Margin="-22,-18,-22,-22">
                    <TextBlock Foreground="White" FontFamily="Verdana"  FontSize="20" Margin="0 20 0 10" Text="Данные клиента" HorizontalAlignment="Center"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="ClientsLabel" HorizontalAlignment="Left" Foreground="White" Content="Клиенты" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="10,29,0,0" Width="120"/>
                        <ComboBox x:Name="ClientComboBox" IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Surname"
                                  Width="226" Height="24" Margin="2 30 0 0" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding Clients}"
                                  SelectedItem="{Binding SelectedClient}"
                                  Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding IsClientListOpen}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Surname}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SurnameLabel" HorizontalAlignment="Left" Foreground="White" Content="Фамилия" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,23,40,0" Width="120"/>
                        <TextBox x:Name="SurnameTextBox" MaxLength="33" Margin="1,25,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                            Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Label x:Name="SurnameErrorLabel" HorizontalAlignment="Right" Content="{Binding SurnameError}" FontSize="13" Foreground="#FFFF8A80" Height="27" Margin="0 0 125 0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="InitialsLabel" HorizontalAlignment="Left" Foreground="White" Content="Инициалы" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,-2,40,0" Width="120"/>
                        <TextBox x:Name="InitialsTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                            Text="{Binding Initials, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Label x:Name="InitialsErrorLabel" HorizontalAlignment="Right" Content="{Binding InitialsError}" FontSize="13" Foreground="#FFFF8A80" Margin="0 0 125 0" Height="27"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="EmailLabel" HorizontalAlignment="Left" Foreground="White" Content="Почта" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,-2,40,0" Width="120"/>
                        <TextBox x:Name="EmailTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Label x:Name="EmailErrorLabel" HorizontalAlignment="Right" Content="{Binding EmailError}" FontSize="13" Foreground="#FFFF8A80" Margin="0 0 125 0" Height="27"/>

                    <Grid>
                        <Label x:Name="PhoneLabel" HorizontalAlignment="Left" Foreground="White" Content="Телефон" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,-2,40,0" Width="120"/>
                        <TextBox x:Name="PhoneTextBox" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                    Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                            Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Label x:Name="PhoneErrorLabel" HorizontalAlignment="Right" Content="{Binding PhoneError}" FontSize="13" Foreground="#FFFF8A80" Margin="0 0 125 0" Height="27"/>
                    <Grid>
                        <Label x:Name="PassportNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="Номер паспорта" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="10,-2,0,0" Width="120"/>
                        <TextBox x:Name="PassportNumberTextBox" MaxLength="9" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"
                            Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Label x:Name="PassportNumberErrorLabel" HorizontalAlignment="Right" Content="{Binding PassportNumberError}" FontSize="13" Foreground="#FFFF8A80" Margin="0 0 125 0" Height="27"/>
                    <Grid>
                        <Label x:Name="IdentificationLabel" HorizontalAlignment="Left" Foreground="White" Content="Идентифи-&#x0a;кационный&#x0a;номер" FontFamily="Verdana" VerticalAlignment="Top" Height="60" Margin="10,-10,0,0" Width="143"/>
                        <TextBox x:Name="IdentificationTextBox" MaxLength="14" Margin="126,1,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="226" Height="24" FontSize="14" VerticalAlignment="Top"
                            Text="{Binding IdentificationNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label x:Name="IdentificationNumberErrorLabel" HorizontalAlignment="Right" Content="{Binding IdentificationNumberError}" FontSize="13" Foreground="#FFFF8A80" Margin="0,30,125,-7" Height="27"/>
                    </Grid>

                    <Grid Margin="0 5 0 0" Height="48" Width="255">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AcceptButton" Content="Заключить договор" Style="{StaticResource mainButton}" Margin="5,7,10,1" BorderBrush="White" Background="White" Foreground="Black" Command="{Binding AcceptCommand}"/>
                    </Grid>

                </StackPanel>
            </Border>
            <Border Width="498" Height="227" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Margin="516,358,0,0">
                <StackPanel Margin="-22,-18,-22,-22" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0.31"/>
                            <RotateTransform/>
                            <TranslateTransform X="0.745"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock Foreground="White" FontFamily="Verdana"  FontSize="20" Margin="0 0 0 10" Text="Детали" HorizontalAlignment="Center"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="StartDateLabel" HorizontalAlignment="Left" Foreground="White" Content="Дата начала" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,23,40,0" Width="120"/>
                        <xctk:DateTimePicker x:Name="StartDatePicker" Margin="1,25,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                            Value="{Binding StartDate, Mode=TwoWay}"/>
                    </Grid>
                    <Label x:Name="StartDateErrorLabel" HorizontalAlignment="Right" Content="{Binding StartDateError}" FontSize="13" Foreground="#FFFF8A80" Height="27" Margin="0 0 125 0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="EndDateLabel" HorizontalAlignment="Left" Foreground="White" Content="Дата окончания" FontFamily="Verdana" VerticalAlignment="Center" Height="24" Margin="10,-2,40,0" Width="120"/>
                        <xctk:DateTimePicker x:Name="EndDatePicker" Margin="0,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                            Value="{Binding EndDate, Mode=TwoWay}"/>
                    </Grid>
                    <Label x:Name="EndDateErrorLabel" HorizontalAlignment="Right" Content="{Binding EndDateError}" FontSize="13" Foreground="#FFFF8A80" Margin="0 0 125 0" Height="27"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="83*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DaysLabel" HorizontalAlignment="Left" Foreground="White" Content="Кол-во дней" FontFamily="Verdana" VerticalAlignment="Center" Height="25" Margin="12,0,0,0" Width="109" Grid.Column="0"/>
                        <Label x:Name="TotalLabel" HorizontalAlignment="Left" Foreground="White" Content="Стоимость" FontFamily="Verdana" VerticalAlignment="Center" Height="25" Margin="140,0,0,0" Width="81" Grid.Column="1"/>

                        <TextBox x:Name="DaysTextBox" MaxLength="33" Margin="123,0,0,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Left" Width="116" Height="24" FontSize="14" VerticalAlignment="Top" BorderBrush="#212121" IsReadOnly="True"
                            Text="{Binding DaysText, Mode=OneWay}"/>
                        <TextBox x:Name="TotalTextBox" MaxLength="33" Margin="0,0,124,0" Padding="0" Foreground="Black" 
                            Panel.ZIndex="1" HorizontalAlignment="Right" Width="115" Height="24" FontSize="14" VerticalAlignment="Top" BorderBrush="#212121" Grid.Column="1" IsReadOnly="True"
                            Text="{Binding TotalText, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 2 0 0" BorderBrush="Black" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>