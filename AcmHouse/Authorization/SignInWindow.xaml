<Window x:Class="AcmHouse.Authorization.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Height="720" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10"
                MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>


                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                    <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                    <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
                </StackPanel>

                <Label HorizontalAlignment="Center" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="24"/>
            </Grid>
        </Border>

        <!--Middle Section-->
        <Grid Grid.Row="1">
            <Grid.Background>
                <SolidColorBrush Color="White"/>
            </Grid.Background>
            <Grid>
                <Grid.Background>
                    <ImageBrush/>
                </Grid.Background>
            </Grid>
            <!--Input Form-->
            <Border Width="404" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Padding="30" Background="DimGray" Height="316">
                <StackPanel Margin="-22,-18,-22,-22">
                    <TextBlock Foreground="White" FontFamily="Verdana" FontSize="20" Margin="0 0 0 10" Text="Вход" HorizontalAlignment="Center"/>

                    <!--Email TextBox-->
                    <Grid>
                        <Label x:Name="LabelEmail" HorizontalAlignment="Center" Foreground="White" FontFamily="Verdana" Content="Почта" VerticalAlignment="Center" Height="24" Margin="0,27,235,0" Width="120"/>

                        <TextBox x:Name="TextBoxEmail" Margin="0,30,0,0" Padding="0" Foreground="Black" 
                                   Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"
                                   Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="TextBoxEmailNotify" HorizontalAlignment="Right" FontFamily="Verdana" Content="{Binding EmailError}" Foreground="Red"  Margin="0 0 80 0" Height="25"/>

                    <!--Password TextBox-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="LabelPassword" HorizontalAlignment="Center" Foreground="White" FontFamily="Verdana" Content="Пароль" VerticalAlignment="Center" Height="24" Margin="0,17,50,0" Width="120"/>

                        <PasswordBox x:Name="TextBoxPassword" Margin="0,20,0,0" Padding="0" Foreground="Black" 
                                   Panel.ZIndex="1"  HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"
                                   PasswordChanged="TextBoxPassword_PasswordChanged"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="TextBoxPasswordNotify" HorizontalAlignment="Right" FontFamily="Verdana" Content="{Binding PasswordError}" Margin="0 0 80 0" Foreground="Red" Height="25"/>


                    <!--<CheckBox x:Name="CheckBoxSession" Style="{DynamicResource CheckBoxStyle1}" FontFamily="Verdana" Content="Remember me" Margin="20 10 0 5" IsChecked="True" Foreground="White"/>-->

                    <!--Buttons-->
                    <Grid Margin="0 10 0 0" Width="244">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SignInButton" Content="Войти" Style="{StaticResource mainButton}" Margin="8,4,7,6" BorderBrush="White" Background="White" Foreground="Black" Command="{Binding SignInCommand}" IsDefault="True"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 2 0 0" BorderBrush="Black" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <TextBlock Margin="15 0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" Foreground="Black" Text="Accommodation Rental"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>