<Window x:Class="AcmHouse.Authorization.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:functions="clr-namespace:AcmHouse.Functions"

        mc:Ignorable="d" Height="748" Width="1024" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--Top Section-->
        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Background="White" CornerRadius="5 5 0 0 " Padding="10"
                MouseDown ="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="WindowOpenFull" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowOpenFull_Click"/>
                    <Button x:Name="WindowHide" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowHide_Click"/>
                    <Button x:Name="WindowClose" Style ="{StaticResource topButtonIcon}" Background="White" Click="WindowClose_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="125,0,0,0" Width="774">
                    <Button x:Name="OffersButton" Style="{StaticResource topButtonsPanel}" Content="Учет предложений" Click="OffersButton_Click" Width="163" Foreground="Black">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OffersContextMenu">
                                <MenuItem Header="Жилой" Click="ResidentialOffers_Click"/>
                                <MenuItem Header="Коммерческой" Click="CommercialOffers_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="RentButton" Style="{StaticResource topButtonsPanel}" Content="Аренда" Width="71" Foreground="Black" Click="RentButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="RentContextMenu">
                                <MenuItem Header="Жилая" Click="Residential_Click"/>
                                <MenuItem Header="Коммерческая" Click="Commercial_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="AccommodationsButton" Style="{StaticResource topButtonsPanel}" Content="Договоры" Click="RentalTrackingButton_Click" Width="100" Foreground="Black"/>
                    <Button x:Name="EmployeesButton" Style="{StaticResource topButtonsPanel}" Content="Сотрудники" Click="EmployeesTrackingButton_Click" Width="100" Foreground="Black"/>
                    <Button x:Name="EventsButton" Style="{StaticResource topButtonsPanel}" Content="Мероприятия" Click="EventsTrackingButton_Click" Width="120" Foreground="Black"/>
                    <Button x:Name="ReportButton" Style="{StaticResource topButtonsPanel}" Content="Отчет" Click="ReportButton_Click" Width="58" Foreground="Black"/>
                </StackPanel>

                <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="AcmHouse" Foreground="Black" FontFamily="Verdana" FontSize="22"/>
            </Grid>
        </Border>

        <!--Middle Section-->
        <Grid Grid.Row="1">
            <Grid.Background>
                <SolidColorBrush Color="White"/>

            </Grid.Background>
            <Grid>
                <Grid.Background>
                    <ImageBrush/>
                </Grid.Background>
            </Grid>
            <!--Input Form-->
            <Border Width="428" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="2" CornerRadius="7" Padding="30" Background="DimGray" Height="590">
                <StackPanel Margin="-22,-18,-22,-22">
                    <TextBlock Foreground="White" FontFamily="Verdana"  FontSize="20" Margin="0 0 0 10" Text="Регистрация сотрудника" HorizontalAlignment="Center"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="LabelName" HorizontalAlignment="Left" Foreground="White" Content="Инициалы" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="6,15,0,0" Width="120"/>
                        <TextBox x:Name="TextBoxName" MaxLength="33" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                                   Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top" />
                    </Grid>
                    <Label x:Name="TextBoxNameNotify" HorizontalAlignment="Right" Content="" Foreground="White" Height="25" Margin="0 0 92 0" FontFamily="Verdana" FontSize="12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="LabelSurname" HorizontalAlignment="Left" Foreground="White" Content="Фамилия" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="6,14,0,0" Width="120"/>
                        <TextBox x:Name="TextBoxSurname" MaxLength="33" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                                   Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="TextBoxSurnameNotify" HorizontalAlignment="Right" Content="" FontFamily="Verdana" Foreground="White" Margin="0 0 92 0" Height="25" FontSize="12"/>
                    <!--Email TextBox-->
                    <Grid>
                        <Label x:Name="LabelEmail" HorizontalAlignment="Left" Foreground="White" Content="Почта" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="8,14,0,0" Width="120"/>
                        <TextBox x:Name="TextBoxEmail" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                                   Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="TextBoxEmailNotify" HorizontalAlignment="Right" Content="" FontFamily="Verdana" Foreground="White" Margin="0 0 92 0" Height="25" FontSize="12"/>
                    <!--Password TextBox-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="LabelPassword" HorizontalAlignment="Left" Foreground="White" Content="Пароль" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="8,14,0,0" Width="120"/>
                        <TextBox x:Name="TextBoxPassword" MaxLength="33" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                          Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>

                    </Grid>
                    <Label x:Name="TextBoxPasswordNotify" HorizontalAlignment="Right" Content="" FontFamily="Verdana" Foreground="White" Margin="0 0 92 0" Height="25" FontSize="12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="LabelPasswordRepeat" HorizontalAlignment="Left" Foreground="White" Content="Повторный" FontFamily="Verdana" VerticalAlignment="Top" Height="24" Margin="6,14,0,0" Width="120"/>

                        <TextBox x:Name="TextBoxPasswordRepeat" MaxLength="33" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                                   Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="TextBoxPasswordRepeatNotify" HorizontalAlignment="Right" Content="" FontFamily="Verdana" Foreground="White" Margin="0 0 92 0" Height="25" FontSize="12"/>
                    <Grid>
                        <Label x:Name="PassportNumberLabel" HorizontalAlignment="Left" Foreground="White" Content="Номер&#x0a;паспорта" FontFamily="Verdana" VerticalAlignment="Top" Height="39" Margin="6,13,0,0" Width="120"/>
                        <TextBox x:Name="PassportNumberTextBox" MaxLength="9" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14"/>
                        <!--<ICon:PackIconMAterial/>-->
                    </Grid>
                    <Label x:Name="PassportNumberNotify" HorizontalAlignment="Right" Content="" FontFamily="Verdana" FontSize="12" Foreground="White" Margin="0 0 92 0" Height="27"/>
                    <!--Password TextBox-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="83*"/>
                            <ColumnDefinition Width="79*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="IdentificationLabel" HorizontalAlignment="Left" Foreground="White" Content="Идентифи-&#x0a;кационный&#x0a;номер" FontFamily="Verdana" VerticalAlignment="Center" Height="57" Margin="6,0,0,0" Width="143"/>

                        <TextBox x:Name="IdentificationTextBox" MaxLength="14" Margin="0,15,0,0" Padding="0" Foreground="Black" 
                        Panel.ZIndex="1" HorizontalAlignment="Center" Width="226" Height="24" FontSize="14" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                    </Grid>
                    <Label x:Name="IdentificationNotify" HorizontalAlignment="Right" Content="" FontFamily="Verdana" FontSize="12" Foreground="White" Margin="0 0 92 0" Height="27"/>

                    <!--Buttons-->
                    <Grid Margin="0 -5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SignUpButton" Content="Зарегистрировать сотрудника" Style="{StaticResource mainButton}" Margin="92,0,92,0" BorderBrush="White" Background="White" Foreground="Black" Click="SignUpButton_Click"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>

        <!--Bottom Section-->
        <Border Grid.Row="2" BorderThickness="0 2 0 0" BorderBrush="Black" CornerRadius="0 0 5 5" Padding="10" Background="White">
            <Grid>
                <TextBlock Margin="15 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="Black" Text="AcmHouse Co. 2024"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="Exit" Style="{StaticResource bottomButton}" Content="Выйти" Click="Exit_Click" Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>